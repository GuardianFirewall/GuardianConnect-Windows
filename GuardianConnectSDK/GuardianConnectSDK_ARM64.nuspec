    <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\GuardianConnect.Shared.dll" target="lib\net9.0\GuardianConnect.Shared.dll"  />
    <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\GuardianConnect.Abstractions.dll" target="lib\net9.0\GuardianConnect.Abstractions.dll"/>
    <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\Win32Calls.dll" target="lib\net9.0\Win32Calls.dll"  />
    <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\Win32Calls.WFP.dll" target="lib\net9.0\Win32Calls.WFP.dll"  />

