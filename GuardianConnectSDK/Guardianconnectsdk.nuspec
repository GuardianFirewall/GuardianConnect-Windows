<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>GuardianConnectSDK (x64)</id>
    <version>0.45.0</version>
    <title>GuardianConnect SDK Nuget Bundle Package for x64</title>
    <authors>DNSFilter, Inc.</authors>
    <license type="expression">MIT</license>
    <icon>Guardian.png</icon>
    <projectUrl>https://github.com/GuardianFirewall/guardianconnect-windows</projectUrl>
    <description>Use this Nuget package to interact with the Guardian Firewall VPN Infrastructure</description>
    <releaseNotes>$(Version): Beta Release as SDK package</releaseNotes>
    <copyright>Copyright DNSFilter, Inc.</copyright>
    <tags>GuardianConnectSDK Windows Beta</tags>
    <dependencies>
      <group targetFramework="net9.0">
        <!-- Add your dependencies here -->
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="GuardianConnectSDK.targets" target="buildTransitive\GuardianConnectSDK.targets" />
    <file src="..\README.md" target="content"/>
    <file src="Guardian.png"/>

    <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.dll" target="lib\net9.0\GuardianConnect.dll"  />
    <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.Shared.dll" target="lib\net9.0\GuardianConnect.Shared.dll"  />
    <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\NativeRoutines.dll" target="lib\net9.0\NativeRoutines.dll"  />
    <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\Ijwhost.dll" target="lib\net9.0\Ijwhost.dll"  />
