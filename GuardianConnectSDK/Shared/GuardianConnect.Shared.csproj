<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64;ARM64</Platforms>
        <AssemblyVersion>0.10.1.52</AssemblyVersion>
        <FileVersion>0.10.1.52</FileVersion>
        <Title>GuardianConnect SDK Shared Libraries</Title>
        <Version>0.10.1.52</Version>
        <Authors>Guardian Group of DNSFilter, Inc.</Authors>
        <Copyright>DNSFilter, Inc.</Copyright>
        <TargetFramework>net9.0</TargetFramework>
        <PackageIcon>Guardian.ico</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="Serilog" Version="4.0.1" />
      <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
      <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
      <PackageReference Include="Serilog.Enrichers.WithCaller" Version="1.2.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
      <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Guardian.ico">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

</Project>
