<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Was implied by the CsWin32 package build props; now that generation is
             frozen and the package is gone, enable unsafe explicitly for the
             checked-in P/Invoke + the WFP interop. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- CA1418: CsWin32 generated code uses 'windowsserver' platform name not known to the analyzer -->
        <NoWarn>$(NoWarn);CA1418</NoWarn>
    </PropertyGroup>

    <!-- CsWin32 generation is FROZEN: the P/Invoke surface is checked in under
         Generated/ and compiled as static source; the source generator is not
         run at build time. To regenerate (e.g. to add a Win32 API): temporarily
         restore the Microsoft.Windows.CsWin32 PackageReference below + the two
         AdditionalFiles, edit NativeMethods.txt, build with
         -p:EmitCompilerGeneratedFiles=true, copy the emitted *.g.cs from obj
         into Generated/, then remove the package again.
    <ItemGroup>
        <AdditionalFiles Include="NativeMethods.json"/>
        <AdditionalFiles Include="NativeMethods.txt"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    -->

    <ItemGroup>
        <ProjectReference Include="..\Shared\GuardianConnect.Shared.csproj"/>
    </ItemGroup>

</Project>
