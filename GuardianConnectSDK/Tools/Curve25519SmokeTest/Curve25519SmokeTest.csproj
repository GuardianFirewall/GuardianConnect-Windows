<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>GuardianConnect.Tools.Curve25519SmokeTest</RootNamespace>
        <AssemblyName>Curve25519SmokeTest</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>x64;ARM64</Platforms>

        <IsPackable>false</IsPackable>
        <PublishAot>false</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Win32Calls.WireGuard\Win32Calls.WireGuard.csproj" />
    </ItemGroup>

    <!-- curve25519.dll lives next to the exe at runtime via default DLL search order. -->
    <ItemGroup Condition=" '$(Platform)' == 'x64' ">
        <None Include="..\..\native\curve25519\win-x64\curve25519.dll">
            <Link>curve25519.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
