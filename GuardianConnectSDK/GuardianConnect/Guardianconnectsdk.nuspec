<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>GuardianConnect</id>
    <version>1.0.0.0</version>
    <title>GuardianConnect SDK Nuget Bundle Package</title>
    <authors>DNSFilter, Inc.</authors>
    <license type="expression">MIT</license>
    <icon>Guardian.png</icon>
    <projectUrl>https://github.com/GuardianFirewall/guardianconnect-windows</projectUrl>
    <description>Use this Nuget package to interact with the Guardian Firewall VPN Infrastructure</description>
    <releaseNotes>$(Version): Beta Release as SDK package</releaseNotes>
    <copyright>Copyright DNSFilter, Inc.</copyright>
    <tags>GuardianConnectSDK Windows Beta</tags>
    <dependencies>
<!--
      <group targetFramework="$(TargetFramework)"/>
-->
      <group targetFramework="net9.0"/>
    </dependencies>
  </metadata>
  <files>
  <file src=".\README.md" target="lib"/>
  <file src="Guardian.png"/>
    <!--
    <file src="GuardianConnect\bin\$(Platform)\Release\$(TargetFramework)\*.*" target="lib\$(TargetFramework)\$(Platform)"/>
    <file src="$(SolutionDir)\BuildOutput\runtimes\$(TargetFramework)\$(Platform)\*.*" target="lib\runtimes\$(TargetFramework)\$(Platform)"/>
    -->
    
    <file src="$(SolutionDir)\BuildOutput\runtimes\net9.0-windows\**\*.*" target="lib\runtimes\net9.0-windows\"/>
  </files>
</package>
