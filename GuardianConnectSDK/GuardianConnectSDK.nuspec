<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>GuardianConnectSDK</id>
        <version>0.0.0</version>
        <title>GuardianConnect SDK</title>
        <authors>DNSFilter, Inc.</authors>
        <license type="expression">MIT</license>
        <icon>Guardian.png</icon>
        <projectUrl>https://github.com/GuardianFirewall/guardianconnect-windows</projectUrl>
        <description>Use this Nuget package to interact with the Guardian Firewall VPN Infrastructure. Multi-platform package containing both x64 and ARM64 runtime assemblies.</description>
        <releaseNotes>$(Version): Multi-platform (x64 + ARM64) consolidated SDK package</releaseNotes>
        <copyright>Copyright DNSFilter, Inc.</copyright>
        <tags>GuardianConnectSDK Windows</tags>
        <dependencies>
            <group targetFramework="net10.0">
                <!-- Add your dependencies here -->
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="..\README.md" target="content"/>
        <file src="..\Guardian.png"/>

        <!-- Compile-time ref assemblies (managed IL is identical across platforms; use x64 build) -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.dll" target="lib\net10.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.Shared.dll" target="lib\net10.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.Abstractions.dll" target="lib\net10.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.dll" target="lib\net10.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.WFP.dll" target="lib\net10.0\Win32Calls.WFP.dll"/>
        <!-- Win32Calls.WireGuard is consumed by GuardianConnect.Services, not GuardianConnect,
             so it doesn't appear in GuardianConnect's BuildOutput. Source from its own. -->
        <file src="BuildOutput\Win32Calls.WireGuard\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.WireGuard.dll" target="lib\net10.0\Win32Calls.WireGuard.dll"/>

        <!-- x64 runtime assemblies -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.dll" target="runtimes\win-x64\lib\net10.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.Shared.dll" target="runtimes\win-x64\lib\net10.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\GuardianConnect.Abstractions.dll" target="runtimes\win-x64\lib\net10.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.dll" target="runtimes\win-x64\lib\net10.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.WFP.dll" target="runtimes\win-x64\lib\net10.0\Win32Calls.WFP.dll"/>
        <file src="BuildOutput\Win32Calls.WireGuard\runtimes\win10-x64\lib\net10.0-windows\Win32Calls.WireGuard.dll" target="runtimes\win-x64\lib\net10.0\Win32Calls.WireGuard.dll"/>

        <!-- ARM64 runtime assemblies -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net10.0-windows\GuardianConnect.dll" target="runtimes\win-arm64\lib\net10.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net10.0-windows\GuardianConnect.Shared.dll" target="runtimes\win-arm64\lib\net10.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net10.0-windows\GuardianConnect.Abstractions.dll" target="runtimes\win-arm64\lib\net10.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net10.0-windows\Win32Calls.dll" target="runtimes\win-arm64\lib\net10.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net10.0-windows\Win32Calls.WFP.dll" target="runtimes\win-arm64\lib\net10.0\Win32Calls.WFP.dll"/>
        <file src="BuildOutput\Win32Calls.WireGuard\runtimes\win10-arm64\lib\net10.0-windows\Win32Calls.WireGuard.dll" target="runtimes\win-arm64\lib\net10.0\Win32Calls.WireGuard.dll"/>

        <!-- Native WireGuardNT driver wrapper. Loaded by Win32Calls.WireGuard via [LibraryImport].
             Vendored under native/wireguard/win-{arch}/ (see VERSION.txt for source + SHAs). -->
        <file src="native\wireguard\win-x64\wireguard.dll" target="runtimes\win-x64\native\wireguard.dll"/>
        <file src="native\wireguard\win-arm64\wireguard.dll" target="runtimes\win-arm64\native\wireguard.dll"/>

        <!-- Curve25519 keygen library, wrapping wireguard-tools' upstream curve25519.c
             (MIT Fiat-Crypto / HACL*). Source under native/curve25519/src/, prebuilt
             DLLs under native/curve25519/win-{arch}/. Loaded by Win32Calls.WireGuard
             via [LibraryImport] for WG dynamic-exchange keypair generation. -->
        <file src="native\curve25519\win-x64\curve25519.dll" target="runtimes\win-x64\native\curve25519.dll"/>
        <file src="native\curve25519\win-arm64\curve25519.dll" target="runtimes\win-arm64\native\curve25519.dll"/>
    </files>
</package>
