<Project>
    <PropertyGroup>
        <Platforms>x64;ARM64</Platforms>
        <TargetFramework>net9.0-windows</TargetFramework>
        <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>

        <Configurations>Release;Debug</Configurations>
        <Authors>DNSFilter, Inc.</Authors>
        <RepositoryUrl>https://github.com/GuardianFirewall/GuardianConnect-Windows</RepositoryUrl>

        <AssemblyVersion>1.2.0</AssemblyVersion>
        <FileVersion>1.2.0</FileVersion>
        <Version>1.2.0</Version>
        <!-- Prerelease suffix: "beta.N" for non-release NuGet packages; empty = stable release.
             VERSION POLICY (1.1.0+): bump the PATCH (third) digit for every fix/build.
             relaxed-poc.N = throwaway PoC line off 1.1.1 GA for gateway-suite tuning:
             connect-negotiation wait (real RAS/IKE error instead of false OK),
             service-published Connecting/Disconnecting states, and the relaxed IKEv2
             suite: ET_Optional + SHA-256 IKE integrity (was ET_RequireMax + SHA-384). -->
        <!-- relaxed-poc.2 adds: IKEv2 dial by server-published gateway IPv4
             (GRDSGWServer ipv4-address/ipv6-address -> credential ServerIPv4Address). -->
        <VersionSuffix>relaxed-poc.2</VersionSuffix>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateReferenceAssembly>true</GenerateReferenceAssembly>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <Deterministic>true</Deterministic>
        <OutDir>..\BuildOutput\$(MSBuildProjectName)\runtimes\win10-$(Platform)\lib\$(TargetFramework)\</OutDir>
    </PropertyGroup>

    <!--
    <PropertyGroup>
        <VCTVersion>14.44.35207</VCTVersion>
        <VCRedistVersion>14.43.34808</VCRedistVersion>
    </PropertyGroup>
    -->

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10"/>

        <!--
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
        <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
        <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
        <PackageReference Include="Serilog.Enrichers.WithCaller" Version="1.3.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
        <PackageReference Include="Serilog.Settings.AppSettings" Version="3.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        -->
    </ItemGroup>
</Project>