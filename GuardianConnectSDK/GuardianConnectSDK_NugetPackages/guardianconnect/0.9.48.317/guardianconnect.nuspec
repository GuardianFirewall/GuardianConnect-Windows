<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>GuardianConnect</id>
    <version>0.1.1.52</version>
    <title>GuardianConnect</title>
    <authors>DNSFilter, Inc.</authors>
    <icon>Guardian.png</icon>
    <description>Package Description</description>
    <repository type="git" url="https://github.com/GuardianFirewall/GuardianConnect-Windows" commit="1b0ee907b323199383c2964dc9c4617d7247ea0e" />
    <dependencies>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="NativeRoutines" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="GuardianConnect.Shared" version="0.1.1.52" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.3" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.1" exclude="Build,Analyzers" />
        <dependency id="Serilog.Enrichers.Thread" version="4.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Extensions.Logging" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Settings.AppSettings" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Settings.Configuration" version="8.0.2" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.Console" version="6.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.Debug" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.File" version="6.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>