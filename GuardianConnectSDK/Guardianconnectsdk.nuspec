    <!-- DIFFERENT APPROACH AS NEEDED - INCLUDE SOURCE CODE OF THE THREE PROJECTS FOR GUARDIAN FIREWALL UI CLIENT:
      GuardianConnect\**, Shared\**, NativeRoutines\**
    <file src="Shared\**\*.*" target="src\Shared" exclude="Shared\obj"/>
    <file src="GuardianConnect\**\*.*" target="src\GuardianConnect" exclude="GuardianConnect\obj"/>
    <file src="NativeRoutines\**\*.*" target="src\NativeRoutines" exclude="NativeRoutines\obj"/>
      -->
