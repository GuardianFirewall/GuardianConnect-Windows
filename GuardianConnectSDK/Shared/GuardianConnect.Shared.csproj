<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>11</LangVersion>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64;ARM64</Platforms>
        <AssemblyVersion>0.9.46.307</AssemblyVersion>
        <FileVersion>0.9.46.307</FileVersion>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Title>GuardianConnect SDK Shared Libraries</Title>
        <Version>0.9.48.316</Version>
        <Authors>Guardian Group of DNSFilter, Inc.</Authors>
        <Copyright>DNSFilter, Inc.</Copyright>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="Serilog" Version="4.0.1" />
      <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
      <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
      <PackageReference Include="Serilog.Enrichers.WithCaller" Version="1.2.0" />
      <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    </ItemGroup>

</Project>
