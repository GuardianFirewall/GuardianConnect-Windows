<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!-- Paths below must match the layout produced by GuardianConnectSDK.nuspec:
	     runtimes\win-<arch>\lib\net10.0 for managed assemblies and
	     runtimes\win-<arch>\native for the native ones. -->
	<ItemGroup>
		<!-- Set CopyToOutputDirectory for a specific DLL in the package -->
		<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-$(Platform)\lib\net10.0\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-$(Platform)\native\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
