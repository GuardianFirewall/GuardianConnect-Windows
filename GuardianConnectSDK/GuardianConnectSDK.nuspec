<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>GuardianConnectSDK</id>
        <version>0.0.0</version>
        <title>GuardianConnect SDK</title>
        <authors>DNSFilter, Inc.</authors>
        <license type="expression">MIT</license>
        <icon>Guardian.png</icon>
        <projectUrl>https://github.com/GuardianFirewall/guardianconnect-windows</projectUrl>
        <description>Use this Nuget package to interact with the Guardian Firewall VPN Infrastructure. Multi-platform package containing both x64 and ARM64 runtime assemblies.</description>
        <releaseNotes>$(Version): Multi-platform (x64 + ARM64) consolidated SDK package</releaseNotes>
        <copyright>Copyright DNSFilter, Inc.</copyright>
        <tags>GuardianConnectSDK Windows</tags>
        <dependencies>
            <group targetFramework="net9.0">
                <!-- Add your dependencies here -->
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="..\README.md" target="content"/>
        <file src="..\Guardian.png"/>

        <!-- Compile-time ref assemblies (managed IL is identical across platforms; use x64 build) -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.dll" target="lib\net9.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.Shared.dll" target="lib\net9.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.Abstractions.dll" target="lib\net9.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\Win32Calls.dll" target="lib\net9.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\Win32Calls.WFP.dll" target="lib\net9.0\Win32Calls.WFP.dll"/>

        <!-- x64 runtime assemblies -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.dll" target="runtimes\win-x64\lib\net9.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.Shared.dll" target="runtimes\win-x64\lib\net9.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\GuardianConnect.Abstractions.dll" target="runtimes\win-x64\lib\net9.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\Win32Calls.dll" target="runtimes\win-x64\lib\net9.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-x64\lib\net9.0-windows\Win32Calls.WFP.dll" target="runtimes\win-x64\lib\net9.0\Win32Calls.WFP.dll"/>

        <!-- ARM64 runtime assemblies -->
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\GuardianConnect.dll" target="runtimes\win-arm64\lib\net9.0\GuardianConnect.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\GuardianConnect.Shared.dll" target="runtimes\win-arm64\lib\net9.0\GuardianConnect.Shared.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\GuardianConnect.Abstractions.dll" target="runtimes\win-arm64\lib\net9.0\GuardianConnect.Abstractions.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\Win32Calls.dll" target="runtimes\win-arm64\lib\net9.0\Win32Calls.dll"/>
        <file src="BuildOutput\GuardianConnect\runtimes\win10-arm64\lib\net9.0-windows\Win32Calls.WFP.dll" target="runtimes\win-arm64\lib\net9.0\Win32Calls.WFP.dll"/>
    </files>
</package>
