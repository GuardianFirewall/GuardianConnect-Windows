<?xml version="1.0" encoding="utf-8"?>
<package >
	<metadata>
		<id>GuardianFirewallService</id>
		<!-- THIS VERSION IS NOT USED IN THE BUILD, IT IS SET IN THE BUILD PIPELINE -->
		<version>0.24.2</version>
		<title>GuardianFirewall Service</title>
		<authors>DNSFilter, Inc.</authors>
		<license type="expression">MIT</license>
		<icon>Guardian.png</icon>
		<projectUrl>https://github.com/GuardianFirewall/guardianconnect-windows</projectUrl>
		<description>Use this Nuget package to interact with the Guardian Firewall VPN Infrastructure</description>
		<releaseNotes>$(Version) Beta Release of Guardian Windows Service package</releaseNotes>
		<copyright>Copyright DNSFilter, Inc.</copyright>
		<tags>GuardianFirewallService</tags>
		<dependencies>
			<group targetFramework="net9.0"/>
		</dependencies>
	</metadata>
	<files>
		<file src=".\README.md" target="." />
		<file src="Guardian.png" target="."/>
		<!-- x64 -->
        <file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\Guardian.ico" target="runtimes\win-x64\lib\net9.0" />
        <file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\Guardian.png" target="runtimes\win-x64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\GuardianFirewallService.exe" target="runtimes\win-x64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\installassvc.cmd" target="runtimes\win-x64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\logsettings.json" target="runtimes\win-x64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\x64\Release\net9.0-windows\win-x64\publish\uninstallfromservices.cmd" target="runtimes\win-x64\lib\net9.0" />

		<!-- arm64 -->
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\Guardian.ico" target="runtimes\win-arm64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\Guardian.png" target="runtimes\win-arm64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\GuardianFirewallService.exe" target="runtimes\win-arm64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\installassvc.cmd" target="runtimes\win-arm64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\logsettings.json" target="runtimes\win-arm64\lib\net9.0" />
		<file src="GuardianFirewallService\bin\arm64\Release\net9.0-windows\win-arm64\publish\uninstallfromservices.cmd" target="runtimes\win-arm64\lib\net9.0" />


