<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>

        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <PackageIcon>Guardian.png</PackageIcon>
        <!--
        <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
        -->
        <Platforms>x64;ARM64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\Guardian.png" Pack="true" PackagePath=""/>
        <None Include="..\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GuardianConnect.Abstractions\GuardianConnect.Abstractions.csproj"/>
        <ProjectReference Include="..\Shared\GuardianConnect.Shared.csproj"/>
        <ProjectReference Include="..\Win32Calls\Win32Calls.csproj"/>
        <ProjectReference Include="..\Win32Calls.WireGuard\Win32Calls.WireGuard.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="..\..\Guardian.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- Microsoft.Extensions.Logging[.Abstractions] come from Directory.Build.Props,
             which injects them into every project. Don't redeclare here (NU1504). -->
        <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" />
    </ItemGroup>
</Project>
